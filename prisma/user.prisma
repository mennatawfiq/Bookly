model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  organizedEvents      Event[]
  bookings             Booking[]
  organizerApplications        OrganizerApplication[] @relation("Applicant")
  reviewedApplications         OrganizerApplication[] @relation("Reviewer")
  checkedInTickets              Ticket[]
}

enum UserRole {
  ADMIN
  USER
  ORGANIZER
}