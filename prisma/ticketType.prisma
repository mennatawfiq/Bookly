enum TicketTypeKind {
  GENERAL
  VIP
}

model TicketType {
  id        String         @id @default(uuid())
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)

  type      TicketTypeKind
  capacity  Int
  remaining Int

  tickets   Ticket[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([eventId, type])
}